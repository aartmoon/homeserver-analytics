      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 8,
      "title": "Container availability",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 24,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "container_up",
          "legendFormat": "{{project}} {{service}} {{instance}}"
        }
      ]
    },
    {
      "id": 9,
      "title": "Container working-set bytes",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 32,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "container_memory_working_set_bytes",
          "legendFormat": "{{project}} {{service}} {{instance}}"
        }
      ]
    },
    {
      "id": 10,
      "title": "Container CPU cores (sampled)",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 32,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "container_cpu_usage_cores",
          "legendFormat": "{{project}} {{service}} {{instance}}"
        }
      ]
    },
    {
      "id": 11,
      "title": "Container unexpected restarts /15m",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 40,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "increase(container_restarts_total[15m])",
          "legendFormat": "{{project}} {{service}} {{instance}}"
        }
      ]
    },
    {
      "id": 12,
      "title": "Container OOM events /15m",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 40,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "increase(container_oom_events_total[15m])",
          "legendFormat": "{{project}} {{service}} {{instance}}"
        }
      ]
    },
    {
      "id": 13,
      "title": "Collector age seconds",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 48,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "time() - container_collector_last_success_timestamp_seconds",
          "legendFormat": "{{project}} {{service}} {{instance}}"
        }
      ]
    }
  ],
  "tags": [
    "monitoring"
  ],
  "templating": {
    "list": []
  }
}
