{
  "uid": "projects",
  "title": "Обзор проектов",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "title": "HTTP availability",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "probe_success{project=~\"$project\"}",
          "legendFormat": "{{project}} {{service}} {{instance}} {{device}} {{mountpoint}}"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 2,
      "title": "Synthetic HTTP duration seconds",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "probe_duration_seconds{project=~\"$project\"}",
          "legendFormat": "{{project}} {{service}} {{instance}} {{device}} {{mountpoint}}"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 3,
      "title": "Synthetic HTTP status",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "probe_http_status_code{project=~\"$project\"}",
          "legendFormat": "{{project}} {{service}} {{instance}} {{device}} {{mountpoint}}"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 4,
      "title": "TLS days left",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "(probe_ssl_earliest_cert_expiry{project=~\"$project\"} - time()) / 86400",
          "legendFormat": "{{project}} {{service}} {{instance}} {{device}} {{mountpoint}}"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 5,
      "title": "Reverse proxy requests/s",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by(project,service) (rate(traefik_service_requests_total{project=~\"$project\"}[5m]))",
          "legendFormat": "{{project}} {{service}}"
        }
      ]
    },
    {
      "id": 6,
      "title": "Reverse proxy 5xx /15m",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "(sum by(project,service) (increase(traefik_service_requests_total{project=~\"$project\",code=~\"5..\"}[15m]))) or on(project,service) (sum by(project,service) (increase(traefik_service_requests_total{project=~\"$project\"}[15m])) * 0)",
          "legendFormat": "{{project}} {{service}}"
        }
      ]
    },
    {
      "id": 7,
      "title": "Reverse proxy p95 seconds (>=100 requests/15m)",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 24,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95,sum by(le,project,service)(rate(traefik_service_request_duration_seconds_bucket{project=~\"$project\"}[15m]))) and on(project,service) (sum by(project,service)(increase(traefik_service_requests_total{project=~\"$project\"}[15m])) >=100)",
          "legendFormat": "{{project}} {{service}}"
        }
      ]
    },
    {
      "id": 8,
      "title": "Container memory bytes",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 24,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "container_memory_working_set_bytes{project=~\"$project\"}",
          "legendFormat": "{{service}} {{instance}}"
        }
      ]
    },
    {
      "id": 9,
      "title": "Container CPU cores",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 32,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "container_cpu_usage_cores{project=~\"$project\"}",
          "legendFormat": "{{service}} {{instance}}"
        }
      ]
    },
    {
      "id": 10,
      "title": "Container availability",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 32,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "container_up{project=~\"$project\"}",
          "legendFormat": "{{service}} {{instance}}"
        }
      ]
    },
    {
      "id": 11,
      "title": "Container restarts /15m",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 40,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "increase(container_restarts_total{project=~\"$project\"}[15m])",
          "legendFormat": "{{service}} {{instance}}"
        }
      ]
    }
  ],
  "tags": [
    "monitoring"
  ],
  "templating": {
    "list": [
      {
        "name": "project",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": "label_values(probe_success, project)",
        "refresh": 1,
        "includeAll": true,
        "allValue": ".*",
        "multi": false,
        "current": {
          "text": "All",
          "value": "$__all"
        }
      }
    ]
  }
}
